# TradeLab Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# NEVER commit your actual .env file or API keys!

# Application Mode: demo | paper
APP_MODE=demo

# Market Data Provider: yahoo | fixture | alpha_vantage
MARKET_DATA_PROVIDER=yahoo

# Alpaca Paper Trading Credentials (Optional - required only for Alpaca paper trading)
# Sign up for a free paper trading account at https://alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Enforce paper trading ONLY (Never set to false - TradeLab MVP strictly forbids live trading)
ALPACA_PAPER=true

# Database URL for persistent backtest runs and audit logs
DATABASE_URL=sqlite:///tradelab.db

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
